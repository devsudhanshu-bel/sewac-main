{
  "name": "sewac_citizen_backend",
  "version": "1.0.0",
  "description": "SEWAC Citizen Backend",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:pull:helper": "prisma db pull --schema=prisma/helper/schema.prisma",
    "db:generate:helper": "prisma generate --schema=prisma/helper/schema.prisma",
    "db:pull:sewac": "prisma db pull --schema=prisma/sewac/schema.prisma",
    "db:generate:sewac": "prisma generate --schema=prisma/sewac/schema.prisma"
  },
  "keywords": [
    "sewac",
    "citizen",
    "express",
    "prisma",
    "postgresql"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "streamifier": "^0.1.1",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.19.3"
  }
}
